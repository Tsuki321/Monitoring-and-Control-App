    <!-- About -->
    <string name="about_version">Bersyon 1.0</string>
    <string name="about_description_title">Tungkol</string>
    <string name="about_description">Ang HydroSense ang kasamang software para sa pagmamasid at kontrol ng sistema ng pagsasala ng tubig sa tesis ng Group 1. Ipinapakita nito ang mga kasalukuyang sukat ng sensor at impormasyon ng tangke, at nagbibigay ng kontrol sa mga nakakonektang pump sa mga awtorisadong gumagamit.</string>
    <string name="about_developers_title">Koponan ng Tesis</string>
    <string name="about_group_name">Group 1</string>
    <string name="about_group_role">Sistema ng Pagsasala ng Tubig at Kasamang Software</string>

    <!-- Sensor ranges do not establish drinking-water safety. -->
    <string name="water_quality_disclaimer">Hindi pinatutunayan ng mga sukat na ito na ligtas inumin ang tubig. Gumamit ng angkop na pagsusuri at payo ng kwalipikadong propesyonal bago magpasya kung paano gagamitin ang tubig.</string>

