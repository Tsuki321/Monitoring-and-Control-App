    <!-- Model diagnostics -->
    <string name="filter_model_title">Modelo ng Prediksyon</string>
    <string name="filter_model_explainer">May least-squares na modelo na nag-aaral kung gaano kabilis masira ang bawat bahagi mula sa TDS, turbidity at pH, batay sa nasusukat na oras ng pagtakbo ng five-stage pump. Ang Pump A ay pang-intake lamang at hindi kailanman binibilang sa pagkasira ng filter. Nagsisimula ito sa simuladong datos at nagsisimulang matuto mula sa mga naitalang serbisyo kapag sapat na ang nakatipon.</string>
    <string name="filter_model_row_format">%1$s — kalidad ng fit %2$d%%, %3$d tunay na serbisyo ang naitala</string>
