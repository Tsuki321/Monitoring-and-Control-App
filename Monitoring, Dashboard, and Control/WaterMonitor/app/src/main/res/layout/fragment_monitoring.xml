<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="48dp">

            <!-- Tank Level Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTank"
                style="@style/Style.WaterMonitor.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        style="@style/Style.WaterMonitor.SensorTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/tank_level_label" />

                    <com.watermonitor.app.ui.views.WaterTankView
                        android:id="@+id/waterTankView"
                        android:layout_width="@dimen/tank_width"
                        android:layout_height="@dimen/tank_height" />

                    <TextView
                        android:id="@+id/tvTankPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/tank_percent_waiting"
                        android:textColor="@color/text_medium"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTankDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tank_distance_waiting"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTankWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvLeakStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/leak_status_waiting"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- pH Sensor Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPh"
                style="@style/Style.WaterMonitor.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvPhTitle"
                        style="@style/Style.WaterMonitor.SensorTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_ph"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/imgPhIcon"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/imgPhIcon"
                        android:layout_width="@dimen/sensor_icon_size"
                        android:layout_height="@dimen/sensor_icon_size"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_ph_tube"
                        app:layout_constraintBottom_toBottomOf="@id/tvPhTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.0" />

                    <TextView
                        android:id="@+id/tvPhValue"
                        style="@style/Style.WaterMonitor.SensorValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="7.00"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgPhIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvPhUnit"
                        style="@style/Style.WaterMonitor.SensorUnit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/unit_ph"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPhValue" />

                    <TextView
                        android:id="@+id/tvPhStatus"
                        style="@style/Style.WaterMonitor.StatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Status: Neutral"
                        android:textColor="@color/status_green"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPhUnit"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TDS Sensor Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTds"
                style="@style/Style.WaterMonitor.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvTdsTitle"
                        style="@style/Style.WaterMonitor.SensorTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_tds"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/imgTdsIcon"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/imgTdsIcon"
                        android:layout_width="@dimen/sensor_icon_size"
                        android:layout_height="@dimen/sensor_icon_size"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_tds_particles"
                        app:layout_constraintBottom_toBottomOf="@id/tvTdsTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.0" />

                    <TextView
                        android:id="@+id/tvTdsValue"
                        style="@style/Style.WaterMonitor.SensorValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="150"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgTdsIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvTdsUnit"
                        style="@style/Style.WaterMonitor.SensorUnit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/unit_ppm"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTdsValue" />

                    <TextView
                        android:id="@+id/tvTdsStatus"
                        style="@style/Style.WaterMonitor.StatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Status: Excellent"
                        android:textColor="@color/status_green"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTdsUnit"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Turbidity Sensor Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTurbidity"
                style="@style/Style.WaterMonitor.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvTurbidityTitle"
                        style="@style/Style.WaterMonitor.SensorTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_turbidity"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/imgTurbidityIcon"
                        android:layout_marginEnd="8dp" />

                    <ImageView
                        android:id="@+id/imgTurbidityIcon"
                        android:layout_width="@dimen/sensor_icon_size"
                        android:layout_height="@dimen/sensor_icon_size"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_turbidity_drop"
                        app:layout_constraintBottom_toBottomOf="@id/tvTurbidityTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.0" />

                    <TextView
                        android:id="@+id/tvTurbidityValue"
                        style="@style/Style.WaterMonitor.SensorValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0%"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgTurbidityIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <LinearLayout
                        android:id="@+id/turbidityUnitRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTurbidityValue">

                        <TextView
                            android:id="@+id/tvTurbidityUnit"
                            style="@style/Style.WaterMonitor.SensorUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.5 NTU" />

                        <TextView
                            android:id="@+id/tvTurbidityCloudiness"
                            style="@style/Style.WaterMonitor.SensorUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="· Not Cloudy" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
