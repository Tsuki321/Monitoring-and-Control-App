<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="48dp">

            <!-- Synthesized Water Safety Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWaterSafety"
                style="@style/Style.WaterMonitor.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Style.WaterMonitor.SensorTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/water_safety_title" />

                        <ImageView
                            android:id="@+id/imgWaterSafetyStatus"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_status_dot" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWaterSafetyStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/water_safety_checking"
                        android:textColor="@color/status_grey"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tvWaterSafetySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/water_safety_checking_summary"
                        android:textColor="@color/text_medium"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/card_border" />

                    <TextView
                        android:id="@+id/tvSafetyPh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/water_safety_ph_pending"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSafetyTds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/water_safety_tds_pending"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSafetyTurbidity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/water_safety_turbidity_pending"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/water_safety_basis"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- System Status Card (Leak, Pumps) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSystemStatus"
                style="@style/Style.WaterMonitor.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pump_status_title"
                        style="@style/Style.WaterMonitor.SensorTitle"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Leak sensor (RTDB rainDetected) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:id="@+id/dotLeak"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_status_dot"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvLeakStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/leak_status_waiting"
                                android:textSize="15sp"
                                android:textColor="@color/status_grey"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_pump"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvPumpAStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pump A: OFF"
                                android:textSize="15sp"
                                android:textColor="@color/status_grey"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_pump"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvPumpBStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pump B: OFF"
                                android:textSize="15sp"
                                android:textColor="@color/status_grey"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sensor Online Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSensorStatus"
                style="@style/Style.WaterMonitor.GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:alpha="0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_status_title"
                        style="@style/Style.WaterMonitor.SensorTitle"
                        android:layout_marginBottom="12dp" />

                    <!-- pH row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:id="@+id/dotPh"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_status_dot"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvPhOnline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="pH: Online"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark" />

                    </LinearLayout>

                    <!-- TDS row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:id="@+id/dotTds"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_status_dot"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvTdsOnline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TDS: Online"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark" />

                    </LinearLayout>

                    <!-- Turbidity row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/dotTurbidity"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_status_dot"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvTurbidityOnline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Turbidity: Online"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
