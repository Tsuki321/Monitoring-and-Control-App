<?xml version="1.0" encoding="utf-8"?>
<!-- Pump + water drop control icon -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="28dp"
    android:viewportWidth="32"
    android:viewportHeight="32">

    <!-- Pump body (rectangle) -->
    <path
        android:pathData="M6,14 L16,14 L16,24 L6,24 Z"
        android:fillColor="#1A237E" />

    <!-- Pump motor circle -->
    <path
        android:pathData="M11,19 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:fillColor="#4DB8C8" />
    <path
        android:pathData="M11,19 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:fillColor="#1A237E" />

    <!-- Pipe going right -->
    <path
        android:pathData="M16,17 L22,17 L22,14"
        android:fillColor="#00000000"
        android:strokeColor="#1A237E"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Water drop -->
    <path
        android:pathData="M22,6 C22,6 18,11 18,14 C18,16.2 19.8,18 22,18 C24.2,18 26,16.2 26,14 C26,11 22,6 22,6 Z"
        android:fillColor="#804DB8C8"
        android:strokeColor="#0D7A8A"
        android:strokeWidth="1" />

    <!-- Drop highlight -->
    <path
        android:pathData="M20,11 C20,11 19,13 19,14"
        android:fillColor="#00000000"
        android:strokeColor="#A8E6EF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
</vector>
