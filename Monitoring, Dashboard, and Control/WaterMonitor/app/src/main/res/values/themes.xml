<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WaterMonitor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_deep</item>
        <item name="colorPrimaryVariant">@color/teal_mid</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/text_light</item>
        <item name="android:colorBackground">@color/bg_gradient_start</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- Base style required by all Style.WaterMonitor.* dot-notation child styles -->
    <style name="Style.WaterMonitor" parent="" />

    <!-- Glass card style - enhanced with better shadows -->
    <style name="Style.WaterMonitor.GlassCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/glass_white</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/glass_border_highlight</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Sensor value text - lighter weight, larger -->
    <style name="Style.WaterMonitor.SensorValue">
        <item name="android:textSize">@dimen/sensor_value_text_size</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Sensor title text - refined with letter spacing -->
    <style name="Style.WaterMonitor.SensorTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Sensor unit text - lighter, more subtle -->
    <style name="Style.WaterMonitor.SensorUnit">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- Status text - refined hierarchy -->
    <style name="Style.WaterMonitor.StatusText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Top bar title - more refined -->
    <style name="Style.WaterMonitor.TopBarTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Navigation button style -->
    <style name="Style.WaterMonitor.NavButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/accent_blue</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:backgroundTint">@color/glass_white</item>
        <item name="cornerRadius">@dimen/card_corner_radius_small</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Control card label - refined -->
    <style name="Style.WaterMonitor.ControlLabel">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Splash screen theme: same base as the app but with the ocean-gradient
         window background so there is no white flash before the layout inflates. -->
    <style name="Theme.WaterMonitor.Splash" parent="Theme.WaterMonitor">
        <item name="android:windowBackground">@drawable/bg_ocean_gradient</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Circular image view for profile pictures -->
    <style name="CircularImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
