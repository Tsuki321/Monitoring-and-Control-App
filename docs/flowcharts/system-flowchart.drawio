 style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#F1F8FA;strokeColor=#36819A;strokeWidth=2;fontColor=#193A4B;" vertex="1" parent="1"><mxGeometry x="685" y="1860" width="730" height="215" as="geometry" /></mxCell><mxCell id="cycle" value="If A enabled: cycle 30 s ON / 60 s OFF&lt;br&gt;Otherwise keep A OFF; apply B state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#F1F8FA;strokeColor=#36819A;strokeWidth=2;fontColor=#193A4B;" vertex="1" parent="1"><mxGeometry x="690" y="2150" width="720" height="110" as="geometry" /></mxCell><mxCell id="auto_u" value="U" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#FFFFFF;strokeColor=#36819A;strokeWidth=2;fontColor=#193A4B;" vertex="1" parent="1"><mxGeometry x="1540" y="2175" width="60" height="60" as="geometry" /></mxCell><mxCell id="update_u" value="U" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#FFFFFF;strokeColor=#36819A;strokeWidth=2;fontColor=#193A4B;" vertex="1" parent="1"><mxGeometry x="140" y="1420" width="60" height="60" as="geometry" /></mxCell><mxCell id="update" value="Apply / retain relay outputs;&lt;br&gt;update actual pump state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#F1F8FA;strokeColor=#36819A;strokeWidth=2;fontColor=#193A4B;" vertex="1" parent="1"><mxGeometry x="65" y="1545" width="485" height="110" as="geometry" /></mxCell><mxCell id="publish" value="When cloud is ready:&lt;br&gt;publish changed pump states;&lt;br&gt;publish sensor data and runtime&lt;br&gt;at the telemetry interval" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#F1F8FA;strokeColor=#36819A;strokeWidth=2;fontColor=#193A4B;" vertex="1" parent="1"><mxGeometry x="65" y="1725" width="485" height="160" as="geometry" /></mxCell><mxCell id="lcd" value="Refresh local LCD and&lt;br&gt;Firebase-fed Android views" 