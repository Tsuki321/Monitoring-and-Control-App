ry></mxCell><mxCell id="label17" value="No" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=22;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1245" y="1685" width="230" height="40" as="geometry" /></mxCell><mxCell id="edge18" value="" style="endArrow=block;endFill=1;strokeColor=#456371;strokeWidth=2;rounded=0;fontFamily=Arial;fontSize=22;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2125" y="1740" as="sourcePoint" /><mxPoint x="2230" y="1740" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge19" value="" style="endArrow=block;endFill=1;strokeColor=#456371;strokeWidth=2;rounded=0;fontFamily=Arial;fontSize=22;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="1800" as="sourcePoint" /><mxPoint x="1050" y="1860" as="targetPoint" /></mxGeometry></mxCell><mxCell id="label19" value="Yes" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=22;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="985" y="1812" width="230" height="40" as="geometry" /></mxCell><mxCell id="edge20" value="" style="endArrow=block;endFill=1;strokeColor=#456371;strokeWidth=2;rounded=0;fontFamily=Arial;fontSize=22;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="2075" as="sourcePoint" /><mxPoint x="1050" y="2150" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge21" value="" style="endArrow=block;endFill=1;strokeColor=#456371;strokeWidth=2;rounded=0;fontFamily=Arial;fontSize=22;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1410" y="2205" as="sourcePoint" /><mxPoint x="1540" y="2205" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge22" value="" style="endArrow=block;endFill=1;strokeColor=#456371;strokeWidth=2;rounded=0;fontFamily=Arial;fontSize=22;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="1480" as="sourcePoint" /><mxPoint x="307" y="1545" as="targetPoint" /><Array as="points"><mxPoint x="170" y="1510" /><mxPoint x="307" y="1510" /></Array></mxGeometry></mxCell><mxCell id="edge23" value="" style="endArrow=block;endFill=1;strokeColor=#456371;strokeWidth=2;rounded=0;fontFamily=Arial;fontSize=22;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="307" y="1655" as="sourcePoint" /><mxPoint x="307" y="1725" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge24" value="" style="endArrow=block;endFill=1;strokeColor=#456371;strokeWidth=2;rounded=0;fontFamily=Arial;fontSize=22;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="307" y="1885" as="sourcePoint" /><mxPoint x="307" y="1955" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge25" value="" style="endArrow=block;endFill=1;strokeColor=#456371;strokeWidth=2;rounded=0;fontFamily=Arial;fontSize=22;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="307" y="2065" as="sourcePoint" /><mxPoint x="307" y="2140" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge26" value="" style="endArrow=block;endFill=1;strokeColor=#456371;strokeWidth=2;rounded=0;fontFamily=Arial;fontSize=22;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="307" y="2235" as="sourcePoint" /><mxPoint x="307" y="2280" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note0" value="Water route: biofilter media and the downstream five-stage treatment are distinct assemblies (thesis pp. 61-62)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="335" width="1900" height="100" as="geometry" /></mxCell><mxCell id="note1" value="CONTROLLER SCHEDULE" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=28;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1500" y="515" width="1900" height="100" as="geometry" /></mxCell><mxCell id="note2" value="Control polling and pump / safety checks: 500 ms&lt;br&gt;pH, processed TDS and turbidity: about 1 s&lt;br&gt;TDS raw samples: 40 ms&lt;br&gt;Sensor + runtime telemetry: 5 s&lt;br&gt;Local LCD: 2 s; pump status: on change" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=26;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1500" y="635" width="1900" height="100" as="geometry" /></mxCell><mxCell id="note3" value="APP INTERFACE" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=28;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1500" y="910" width="1900" height="100" as="geometry" /></mxCell><mxCell id="note4" value="App writes mode and pump commands to Firebase.&lt;br&gt;App reads sensor values and actual relay state.&lt;br&gt;Filter model is trained on generated data and&lt;br&gt;uses measured Pump B runtime for live estimates." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=26;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1500" y="1010" width="1900" height="100" as="geometry" /></mxCell><mxCell id="note5" value="FS1 = lower catchment float&lt;br&gt;FS2 = upper catchment float&lt;br&gt;A = intake pump; B = filter-feed pump&lt;br&gt;U = relay update / reporting step&lt;br&gt;R = next main-loop pass" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=25;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1640" y="1930" width="1900" height="100" as="geometry" /></mxCell><mxCell id="note6" value="Leak and full-tank overrides&lt;br&gt;apply in both AUTO and MANUAL." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=26;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1640" y="2200" width="1900" height="100" as="geometry" /></mxCell><mxCell id="foot0" value="Timing and branch details follow Appendix I code. The prose on p. 62 differs on telemetry timing and the full-tank inequality." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=22;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="2357" width="1900" height="65" as="geometry" /></mxCell><mxCell id="foot1" value="Firmware uses a 5-second telemetry interval and a &gt;=100% full-tank stop. Local safety logic continues without a cloud connection." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=22;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="2391" width="1900" height="65" as="geometry" /></mxCell><mxCell id="foot2" value="Sources: physical route, pp. 61-62; existing overview, p. 60; controller constants and safety / AUTO branches, pp. 166-177." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=22;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="2425" width="1900" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>