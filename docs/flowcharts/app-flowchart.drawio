<mxfile host="app.diagrams.net"><diagram name="01  /  HydroSense app flowchart" id="app-flowchart"><mxGraphModel page="1" pageWidth="2240" pageHeight="2110" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="01  /  HydroSense app flowchart" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="1900" height="65" as="geometry" /></mxCell><mxCell id="subtitle" value="Android application workflow | Based on the current source code | Authentication, navigation, monitoring and control" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#193A4B;fontSize=24;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="1900" height="65" as="geometry" /></mxCell><mxCell id="start" value="Open app" style="rounded=1;arcSize=100;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#193A4B;strokeColor=#193A4B;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1000" y="195" width="240" height="65" as="geometry" /></mxCell><mxCell id="init" value="Show splash screen; load&lt;br&gt;saved preferences and filter history" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#F1F8FA;strokeColor=#36819A;strokeWidth=2;fontColor=#193A4B;" vertex="1" parent="1"><mxGeometry x="885" y="295" width="470" height="95" as="geometry" /></mxCell><mxCell id="session" value="Signed in?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#FFF6DE;strokeColor=#AA8022;strokeWidth=2;fontColor=#193A4B;" vertex="1" parent="1"><mxGeometry x="955" y="425" width="330" height="105" as="geometry" /></mxCell><mxCell id="login" value="Log in with email/password,&lt;br&gt;Google, Facebook or saved account" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=25;fillColor=#F1F8FA;strokeColor=#36819A;strokeWidth